    "babel-preset-expo": "~58.0.22",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.1.0",
    "jest": "29.7.0",
    "jest-expo": "~58.0.13",
    "prettier": "3.4.2",
    "react-native-svg-transformer": "1.5.0",
    "react-test-renderer": "19.3.0",
