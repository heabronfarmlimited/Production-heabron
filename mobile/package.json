    "@tanstack/react-query": "5.62.11",
    "axios": "1.7.9",
    "date-fns": "4.1.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
