# Base URLs MUST include the /api suffix.
# e.g. https://heabroncoopscore.com/api
STAGING_BASE_URL=
PRODUCTION_BASE_URL=

# Set to "false" to build against PRODUCTION_BASE_URL.
# Defaults to staging in dev builds.
USE_STAGING=true

# -----------------------------------------------------------------------------
# NOTE — this file is for `expo start` on your own machine only.
#
# An EAS build runs on Expo's servers, where this file does not exist, so the
# values for a real APK live in `eas.json` under build.<profile>.env instead.
# See docs/BUILD_APK.md. Setting a URL only here produces an app with no
# server to talk to.
# -----------------------------------------------------------------------------
