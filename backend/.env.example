# =============================================================================
# HEABRON COOPSCORE — BACKEND ENV
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# In production (Vercel), set these as Environment Variables in the dashboard.

# ----- Server -----
# IMPORTANT: set NODE_ENV=production on the live deployment. The production API
# was observed reporting "env": "development" from /api/health, which skipped
# the startup checks in src/config/index.js. Those checks now also trigger on
# Vercel regardless of NODE_ENV, but NODE_ENV should still be correct.
NODE_ENV=development
PORT=4000

# Optional. Raises or lowers log verbosity without a code change
# (error|warn|info|http|verbose|debug). Defaults to info in production,
# debug otherwise.
# LOG_LEVEL=info

# Optional. Reported by GET /api/health as the running build, so a deployment
# can be identified. On Vercel, VERCEL_GIT_COMMIT_SHA is provided automatically
# and is preferred; set GIT_COMMIT_SHA only when deploying somewhere that does
# not supply it.
# GIT_COMMIT_SHA=

# ----- CORS -----
# Comma-separated list of browser origins allowed to call this API, or `*` for
# any. Read by src/server.js.
#
# This defaults to `*` when unset, which allows ANY website to make requests to
# this API from a visitor's browser. Authentication is Bearer-header only (no
# cookies), so this is not a session-theft risk, but it does leave the
# unauthenticated routes — signup, login, forgot-password, the pre-activation
# upload — callable from arbitrary origins. Set it explicitly in production to
# the admin and partner dashboard origins only.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Public URLs -----
# The URL the frontend app(s) use to call this API (used in email links)
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# ----- JWT -----
# 64+ character random string. Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_64_character_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ----- Supabase -----
# From your Supabase project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ.....
# Service role key – NEVER expose to frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ.....

# ----- Resend (email) -----
# Sign up at https://resend.com and create an API key.
# The heabroncoopscore.com domain is verified — use the addresses below.
#
# REQUIRED on any deployed environment: without it the email service logs
# "[EMAIL DRY RUN]" and discards the message, so every signup OTP and password
# reset is silently dropped while the logs look clean. The API refuses to start
# without it rather than run in that state.
#
# The sending domain of RESEND_FROM_EMAIL must also be *verified* in the Resend
# dashboard — an unverified domain is rejected on every send, which the old
# code logged as "email sent". Check with: node scripts/diagnose-email.js you@example.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Heabron CoopScore <noreply@heabroncoopscore.com>
RESEND_REPLY_TO=info@heabroncoopscore.com

# ----- NIN Verification (Dojah) -----
# Active provider: Dojah (https://dojah.io). Set the credentials below from
# your verified Dojah app. Use sandbox.dojah.io for testing
# (test NIN: 70123456789) and api.dojah.io for production.
NIN_PROVIDER=dojah
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# Fallback: NINAuth (kept in case we switch back; ignored unless NIN_PROVIDER=ninauth)
NINAUTH_BASE_URL=https://api.ninauth.nimc.gov.ng
NINAUTH_CLIENT_ID=
NINAUTH_CLIENT_SECRET=
# Dev mode — when true OR no provider creds are set, stubs out as "verified"
# for any 11-digit NIN. Do not enable in production.
NIN_DEV_MODE=false

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ----- Branding (used in emails) -----
BRAND_NAME=Heabron CoopScore
BRAND_LOGO_URL=https://i.imgur.com/RIpNqJw.png
BRAND_PRIMARY_COLOR=#2C6B47
BRAND_ACCENT_COLOR=#E0A82E
BRAND_SUPPORT_EMAIL=info@heabroncoopscore.com
BRAND_WEBSITE=https://www.heabroncoopscore.com
