# =============================================================================
# Heabron CoopScore — web dashboard environment
# -----------------------------------------------------------------------------
# FIXED — only variables prefixed with VITE_ are ever exposed to the browser
# bundle. Anything else (e.g. SUPABASE_URL / SUPABASE_ANON_KEY, which used to
# sit in the committed .env) is silently dropped by Vite at build time: it does
# nothing, and reading it from the app yields `undefined`. The dashboard talks
# to Supabase only through the backend API, so no Supabase keys belong here.
#
# Copy to `.env` (git-ignored) and fill in.
# =============================================================================

# Public API base URL, including the /api prefix.
# Leave blank in local dev to use the Vite proxy in vite.config.js.
VITE_API_URL=http://localhost:4000/api
