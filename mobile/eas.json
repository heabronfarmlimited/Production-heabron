{
  "cli": {
    "version": ">= 27.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.18.0",
      "android": {
        "image": "latest"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "USE_STAGING": "false",
        "PRODUCTION_BASE_URL": "https://heabroncoopscore.com/api"
      }
    },
    "preview-staging": {
      "extends": "preview",
      "env": {
        "USE_STAGING": "true",
        "STAGING_BASE_URL": "https://heabroncoopscore.com/api"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "USE_STAGING": "false",
        "PRODUCTION_BASE_URL": "https://heabroncoopscore.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
